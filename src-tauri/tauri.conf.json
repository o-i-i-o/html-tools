{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "随机密码生成器",
  "version": "0.1.0",
  "identifier": "com.d02site.passwordgen",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "随机密码生成",
        "width": 900,
        "height": 780,
        "minWidth": 480,
        "minHeight": 600,
        "resizable": true,
        "center": true,
        "url": "password.html"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png"
    ]
  }
}
